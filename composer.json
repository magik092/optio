{
    "name": "magik092/optio",
    "type": "library",
    "description": "Immutable, monadic functional programming for PHP 8.1+, inspired by Vavr.",
    "license": "MIT",
    "authors": [
        {
            "name": "Łukasz Wątor"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.27",
        "nette/php-generator": "^4.0",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Optio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Optio\\Tests\\": "tests/",
            "Optio\\Generators\\": "generators/"
        }
    },
    "scripts": {
        "check-cs": [
            "php-cs-fixer fix --dry-run --diff"
        ],
        "fix-cs": [
            "php-cs-fixer fix"
        ],
        "phpstan": [
            "phpstan analyse -c phpstan.neon"
        ],
        "phpunit": [
            "phpunit --color=always"
        ],
        "generate-tuples": [
            "./bin/generate-tuples"
        ],
        "validate-tuples": [
            "./bin/generate-tuples --validate"
        ],
        "tests": [
            "@validate-tuples",
            "@check-cs",
            "@phpstan",
            "@phpunit"
        ]
    }
}
